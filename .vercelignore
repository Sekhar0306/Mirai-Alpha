# Vercel ignore file - exclude large files from deployment

# Large PDF files (should be uploaded by users, not deployed)
factsheet_archive/**
uploads/**
output/**
logs/**

# All PDFs
*.pdf

# Logs and output
*.log
*.csv
*.json
!mappings/*.json

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
env/
venv/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter notebooks (large, not needed for API)
notebooks/**

# Environment files
.env
.env.local

# Documentation (optional, reduce size)
DEPLOYMENT_NOTES.md
TROUBLESHOOTING_EXTRACTION.md

